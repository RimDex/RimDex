// markdownlint-cli2 configuration (stored centrally, used for both check and fix modes)
// Configuration is applied via justfile recipes: markdownlint (check) and markdownlint-fix (fix)
// Rules live in the shared .markdownlint.json so markdownlint-cli2 and super-linter
// (MARKDOWN_CONFIG_FILE) stay in sync; this file only holds options and scan globs.
{
  "noProgress": true,
  "noBanner": true,
  "globs": [
    "docs/**/*.md"
  ]
}
